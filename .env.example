# Copy this file to .env.local and fill in the values for your machine.

# Postgres connection string.
# Matches docker-compose.yml (npm run db:up) by default:
DATABASE_URL="postgresql://resume:resume_local_dev@localhost:5433/resume_optimizer"

# Auth.js v5 — required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# OAuth providers are optional — omit to fall back to email/password only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# AI provider — Gemini (get a key at https://aistudio.google.com/apikey) or Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
