# Copy this file to .env.local and fill in the values for your machine.

# Postgres connection string.
# Matches docker-compose.yml (npm run db:up) by default:
DATABASE_URL="postgresql://resume:resume_local_dev@localhost:5433/resume_optimizer"

# Auth.js v5 — required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Canonical app URL. Required for self-hosted production Auth.js.
# Use your deployed HTTPS origin in production.
AUTH_URL=http://localhost:3000

# OAuth providers are optional — omit to fall back to email/password only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# AI provider — Gemini (get a key at https://aistudio.google.com/apikey) or Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
GROQ_API_KEY=

# Privacy defaults: browser IndexedDB stores personal workspaces.
# Keep false for the zero-budget deployment; Postgres is then used for accounts only.
# This public setting is compiled into the browser bundle: rebuild when changing it.
NEXT_PUBLIC_CLOUD_WORKSPACES_ENABLED=false
NEXT_PUBLIC_DEFAULT_STORAGE=local

# Set only behind a trusted reverse proxy that supplies the canonical Host header.
AUTH_TRUST_HOST=

# Hosted Neon uses certificate-verified TLS; leave false for local Postgres.
DATABASE_REQUIRE_TLS=false
# Disable Ollama on public hosting; localhost there is the server, not the user's PC.
ALLOW_OLLAMA=true
