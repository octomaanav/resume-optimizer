{
  "manifest_version": 3,
  "name": "Resume Optimizer",
  "version": "1.0.0",
  "description": "Scrape job descriptions, optimize resumes/cover letters/essays, and autofill applications with AI.",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle Resume Optimizer"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar/sidebar.html", "sidebar/sidebar.css", "sidebar/sidebar.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
